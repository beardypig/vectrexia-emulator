{
    "version": 2,
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "base-debug",
            "hidden": true,
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "base-release",
            "hidden": true,
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "visualstudio-vcpkg",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "inherits": "vcpkg-base"
        },
        {
            "name": "visualstudio2026-vcpkg",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "inherits": "vcpkg-base"
        },
        {
            "name": "ninja-vcpkg",
            "hidden": true,
            "generator": "Ninja",
            "inherits": "vcpkg-base"
        },
        {
            "name": "msvc-x64-debug",
            "inherits": [
                "visualstudio-vcpkg",
                "base-debug"
            ],
            "binaryDir": "${sourceDir}/build/x64-Debug",
            "cacheVariables": {
                "CMAKE_GENERATOR_PLATFORM": "x64"
            }
        },
        {
            "name": "msvc-x64-release",
            "inherits": [
                "visualstudio-vcpkg",
                "base-release"
            ],
            "binaryDir": "${sourceDir}/build/x64-Release",
            "cacheVariables": {
                "CMAKE_GENERATOR_PLATFORM": "x64"
            }
        },
        {
            "name": "msvc2026-x64-debug",
            "inherits": [
                "visualstudio2026-vcpkg",
                "base-debug"
            ],
            "binaryDir": "${sourceDir}/build/vs2026-x64-Debug",
            "cacheVariables": {
                "CMAKE_GENERATOR_PLATFORM": "x64"
            }
        },
        {
            "name": "msvc2026-x64-release",
            "inherits": [
                "visualstudio2026-vcpkg",
                "base-release"
            ],
            "binaryDir": "${sourceDir}/build/vs2026-x64-Release",
            "cacheVariables": {
                "CMAKE_GENERATOR_PLATFORM": "x64"
            }
        },
        {
            "name": "ninja-debug",
            "inherits": [
                "ninja-vcpkg",
                "base-debug"
            ],
            "binaryDir": "${sourceDir}/build/ninja-debug"
        },
        {
            "name": "ninja-release",
            "inherits": [
                "ninja-vcpkg",
                "base-release"
            ],
            "binaryDir": "${sourceDir}/build/ninja-release"
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-x64-debug",
            "configurePreset": "msvc-x64-debug",
            "description": "Build for Windows x64 Debug",
            "verbose": true
        },
        {
            "name": "msvc-x64-release",
            "configurePreset": "msvc-x64-release",
            "configuration": "Release",
            "description": "Build for Windows x64 Release",
            "verbose": true
        },
        {
            "name": "msvc2026-x64-debug",
            "configurePreset": "msvc2026-x64-debug",
            "description": "Build for Windows x64 Debug (Visual Studio 2026)",
            "verbose": true
        },
        {
            "name": "msvc2026-x64-release",
            "configurePreset": "msvc2026-x64-release",
            "configuration": "Release",
            "description": "Build for Windows x64 Release (Visual Studio 2026)",
            "verbose": true
        },
        {
            "name": "ninja-debug",
            "configurePreset": "ninja-debug",
            "description": "Build for Ninja debug",
            "verbose": true
        },
        {
            "name": "ninja-release",
            "configurePreset": "ninja-release",
            "description": "Build for Ninja Release",
            "verbose": true
        }
    ],
    "testPresets": [
        {
            "name": "msvc-x64-test",
            "configurePreset": "msvc-x64-debug",
            "description": "Run tests for Windows x64 Debug",
            "displayName": "Tests (MSVC)"
        },
        {
            "name": "msvc2026-x64-test",
            "configurePreset": "msvc2026-x64-debug",
            "description": "Run tests for Windows x64 Debug (Visual Studio 2026)",
            "displayName": "Tests (MSVC 2026)"
        },
        {
            "name": "ninja-test",
            "configurePreset": "ninja-debug",
            "description": "Run tests for Ninja Debug",
            "displayName": "Tests (Ninja)"
        }
    ]
}